# BFF endpoint used by internal HTTP client
NARNIA_BFF_BASE_URL=<set-your-bff-base-url>

# Optional auth bypass for local development only
AUTH_DISABLED=true
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Sonar integration (HU-007)
SONAR_BASE_URL=https://sonarcloud.io
SONAR_TOKEN=
SONAR_PROJECT_KEY_MAP={"afiliaciones":"monitor_afiliaciones"}
